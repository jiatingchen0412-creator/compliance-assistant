# ===== 安全合规自查助手 · 配置文件 =====
# 使用方法：把本文件复制一份改名为 .env，然后按需修改。

# ---------- Web 服务 ----------
# 服务端口（浏览器访问 http://127.0.0.1:8765）
APP_PORT=8765
# 只监听本机，外网访问不到（想局域网访问改成 0.0.0.0，但不建议）
APP_HOST=127.0.0.1
# 启动后自动打开浏览器：true / false
APP_AUTO_OPEN=true

# ---------- 大模型（本地 Ollama） ----------
# Ollama 服务地址，一般不用改
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 使用的模型名（必须先 ollama pull 下载）
#   推荐 qwen2.5:7b-instruct —— 中文好、按格式输出稳定
#   显存富裕可换 qwen2.5:14b-instruct；只有 4G 显存就用 qwen2.5:3b-instruct
LLM_MODEL=qwen2.5:7b-instruct
# 回答的随机性，0 = 最稳定最保守（合规问答建议保持 0）
LLM_TEMPERATURE=0.0
# 单次生成最多输出多少 token
LLM_MAX_TOKENS=2048
# 单次请求超时（秒）。本地 7B 模型首次加载会慢，不要设太小
LLM_TIMEOUT=180

# ---------- 检索 ----------
# 关键词检索得分权重
HYBRID_KEYWORD_WEIGHT=0.5
# 语义向量检索得分权重（两项之和建议为 1.0）
HYBRID_VECTOR_WEIGHT=0.5
# 最终得分低于该阈值 → 判定"知识库中未找到"（0~1）
# 实测参考：真实合规问题一般 0.63~0.89，无关问题 0.14~0.30。
# 调高 = 更保守（宁可说找不到）；调低 = 更容易命中。
RETRIEVAL_MIN_SCORE=0.40
# 每次送入大模型的条款条数（太多会拖慢、也会干扰）
RETRIEVAL_TOP_K=6
# 是否启用本地语义向量模型（首次需下载约 100MB，之后离线）
# 设为 false 则只用关键词检索，零下载
ENABLE_VECTOR_SEARCH=true

# 真流式输出：边生成边推给前端，首字出现更快。
# 万一遇到问题可以改成 false，回退到"生成完再回放"的老路径。
ENABLE_TRUE_STREAMING=true

# ---------- 其他 ----------
# 是否保存聊天记录（本地 SQLite）
SAVE_HISTORY=true
