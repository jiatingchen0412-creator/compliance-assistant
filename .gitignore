# ============================================================
#  安全合规自查助手 · .gitignore
# ============================================================
#  这个文件决定"哪些东西不进版本库"。
#  最要紧的是别把你的**真实问答记录**和**大文件**推上去。
# ============================================================

# ---------- 你的私有数据（绝对不能上传）----------
# app.db 里是你的全部聊天记录和知识库。上传 = 把跟助手的对话公开。
data/app.db
data/app.db-journal
data/app.db-wal
data/app.db-shm
data/backups/
data/logs/

# ---------- 大文件 / 可自动重下的缓存 ----------
# 中文语义模型（约 100MB）和 tools/fetch_model.py 下的 GGUF 原始文件（约 4.4GB）
# 都会在需要时自动下载，不放进版本库。
data/models/

# ---------- 运行环境 ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 本地配置 ----------
# 每个人机器上的端口、模型名可能不同。模板在 .env.example，第一次启动会自动复制。
.env
.env.bak_*

# ---------- 临时产物 ----------
# 以 _ 开头的都是调试用的临时文件（截图、预览页、一次性脚本）
data/_*/
web/_*
tests/_*
tools/_*
*.log
*.tmp
*.bak

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
